# OpenAI-compatible endpoint serving the evaluated model.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=endless-frontier/BigBang-v1

# The three tools exposed by the evaluation harness.
SERPER_API_KEY=
JINA_API_KEY=
E2B_API_KEY=
E2B_TEMPLATE_ID=

# OpenAI-compatible endpoint used for goal-conditioned extraction inside `visit`.
VISIT_SUMMARY_BASE_URL=
VISIT_SUMMARY_API_KEY=
VISIT_SUMMARY_MODEL=

# Optional, explicit judge endpoint. Required only when `--judge` is used.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Required only to download the gated HLE dataset after accepting its license.
HF_TOKEN=
